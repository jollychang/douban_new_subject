{
  "name": "douban-new-subject-helper",
  "version": "0.1.4",
  "private": true,
  "description": "Chrome extension helper for Douban Music new subjects.",
  "scripts": {
    "lint": "node scripts/quality-check.mjs",
    "test": "npm run lint",
    "review": "codex review --uncommitted -c 'model=\"gpt-5.2\"' -c 'model_reasoning_effort=\"high\"' --enable web_search_cached",
    "review:branch": "codex review --base origin/main -c 'model=\"gpt-5.2\"' -c 'model_reasoning_effort=\"high\"' --enable web_search_cached"
  },
  "engines": {
    "node": ">=20"
  }
}
